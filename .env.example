# Base URL of the Admin API (Express on Railway, etc.). Inlined at build time on Vercel —
# set Production + Preview to https://api.yuklenicim.com (no trailing slash). TLS must match.
NEXT_PUBLIC_ADMIN_API_URL="http://localhost:4000"

# Cloudflare Turnstile
NEXT_PUBLIC_ADMIN_TURNSTILE_ENABLED="false"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
