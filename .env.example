# Base URL of the Admin API (Express). Must match TLS: the certificate must include
# this exact hostname (e.g. if https://api.example.com, cert SAN must list api.example.com).
NEXT_PUBLIC_ADMIN_API_URL="http://localhost:4000"

# Cloudflare Turnstile
NEXT_PUBLIC_ADMIN_TURNSTILE_ENABLED="false"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
